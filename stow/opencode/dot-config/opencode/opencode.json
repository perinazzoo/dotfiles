{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "opencode-wakatime",
    "compound-engineering@git+https://github.com/EveryInc/compound-engineering-plugin.git",
    "context-mode"
  ],
  "mcp": {
    "drawdb": {
      "type": "local",
      "command": ["npx", "-y", "@drawdb/mcp"],
      "environment": {
        "DRAWDB_API_KEY": "{env:DRAWDB_API_KEY}"
      }
    },
    "clickup": {
      "type": "remote",
      "url": "https://mcp.clickup.com/mcp"
    }
  },
  "permission": {
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "**/secrets/*": "deny",
      "**/*credential*": "deny",
      "**/*.pem": "deny",
      "**/*.key": "deny",
      "**/*.tfvars": "deny"
    },
    "edit": {
      "*.env": "deny",
      "**/*.tfvars": "deny"
    },
    "bash": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.pem": "deny",
      "*.key": "deny",
      "*.tfvars": "deny",
      "*credential*": "deny",
      "*secrets/*": "deny",
      "rm *": "deny",
      "git rm *": "deny",
      "sudo *": "deny",
      "terraform apply *": "deny",
      "terraform destroy *": "deny",
      "pip *": "deny",
      "pip3 *": "deny",
      "pipx *": "deny",
      "mv *": "ask",
      "scp *": "ask",
      "gh pr merge *": "ask"
    }
  }
}